# =============================================================================
# Sonin Links — Variáveis de Ambiente
# Copie este arquivo para `.env.local` em desenvolvimento (NUNCA commite `.env.local`).
# =============================================================================

# -----------------------------------------------------------------------------
# VARIÁVEIS PÚBLICAS (NEXT_PUBLIC_*) — vão para o bundle do navegador.
# Nunca coloque segredos ou chaves privilegiadas aqui.
# -----------------------------------------------------------------------------

# [PÚBLICA | OBRIGATÓRIA] URL base do site (usada em metadataBase, canonical, OG e robots.txt).
# Em local: http://localhost:3000 | No preview: URL do preview no Netlify | Em produção: domínio final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [PÚBLICA | OBRIGATÓRIA] URL do projeto Supabase (Project Settings -> Data API -> Project URL).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# [PÚBLICA | OBRIGATÓRIA] Chave pública do Supabase (Project Settings -> API Keys -> Publishable ou anon public).
# Segura no navegador porque o acesso ao banco/storage é protegido por RLS no Postgres.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_substitua_pela_chave_publica

# [PÚBLICA | OPCIONAL] Link padrão do grupo de WhatsApp (usado como fallback enquanto `site_settings` estiver vazio).
# O valor efetivo em produção é gerenciado na tela /admin/configuracoes.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# [PÚBLICA | OPCIONAL] Contexto de deploy no Netlify (`production`, `deploy-preview`, `branch-deploy`).
# Preenchida automaticamente via `next.config.ts` a partir do `CONTEXT` do Netlify; habilita `?debugInApp=` apenas fora de produção.
NEXT_PUBLIC_NETLIFY_CONTEXT=

# -----------------------------------------------------------------------------
# SEGREDOS / SOMENTE SERVIDOR — nunca vão para o navegador.
# Nota: `SUPABASE_SERVICE_ROLE_KEY` NÃO é necessária nem usada no MVP, pois todas
# as operações do admin autenticam via sessão Supabase Auth + políticas RLS.
# -----------------------------------------------------------------------------

# [SEGREDO / SOMENTE SERVIDOR | OBRIGATÓRIA] E-mail único do administrador autorizado a acessar `/admin`.
ADMIN_EMAIL=admin@exemplo.com
